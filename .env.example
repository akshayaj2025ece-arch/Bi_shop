# ============================================
# BISHOP — Environment Variables for Vercel / Local
# Add these variables in Vercel Dashboard -> Project Settings -> Environment Variables
# ============================================

# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL
NEXT_PUBLIC_APP_URL=https://your-app-domain.vercel.app

# Razorpay (Optional - for online payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# SMTP Email Service (Optional - for custom email sending)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM="BISHOP" <no-reply@bishop.app>

# Security Secrets (Recommended for production)
SESSION_SECRET=your-random-32-character-session-secret-here
CRON_SECRET=your-random-cron-secret-token-here

